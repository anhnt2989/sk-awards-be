# ─── Application ────────────────────────────────────────────────────────────
APP_NAME="Sao Khuê Awards API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ─── Database ───────────────────────────────────────────────────────────────
# Local development (SQLite)
DB_CONNECTION=sqlite

# Production (PostgreSQL on Render — set DB_URL from Render's connection string)
# DB_CONNECTION=pgsql
# DB_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# DB_SSLMODE=require

# ─── Cache / Session / Queue ────────────────────────────────────────────────
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database

# ─── Mail ───────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Filesystem ─────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# For production file uploads, use S3-compatible storage (Cloudflare R2, AWS S3)
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false
